# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Isi dengan string acak yang panjang sebelum digunakan bersama pengguna lain.
SESSION_SECRET=

# Batas ukuran tiap lampiran dalam MB.
MAX_FILE_MB=50

# Nilai awal saat database pertama kali dibuat.
DEFAULT_ACADEMIC_YEAR=2026/2027
DEFAULT_SEMESTER=Ganjil

# Opsional: lokasi penyimpanan khusus.
# DATA_DIR=
# UPLOAD_DIR=
